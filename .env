# Crie um aplicativo/bot em https://discord.com/developers/applications
DISCORD_TOKEN= # Token discord
CLIENT_ID= token # Identificador da aplicação do bot no Discord Developer Portal.
GUILD_ID= token # ID do servidor do Discord onde o bot vai operar.

# IDs opcionais. Você também pode configurar cargos/canais pelo comando /config.
OWNER_IDS= #ID(s) dos usuários autorizados como donos ou administradores, conforme o código.
MANAGER_ROLE_ID= #ID do cargo de gerente.
EMPLOYEE_ROLE_ID= #ID do cargo de funcionário.
LOG_CHANNEL_ID= #Canal em que o bot registra logs.
DEPOSIT_CHANNEL_ID= #Canal destinado a registros de depósitos, conforme a implementação.
REPORT_CHANNEL_ID= #Canal destinado a relatórios.
